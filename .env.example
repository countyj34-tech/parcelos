# ParcelOS — copy this file to `.env.local` and fill in from Supabase → Project Settings → API

# Public (browser-safe — RLS enforced)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# App
VITE_APP_URL=http://localhost:8080
VITE_PLATFORM_OWNER_EMAIL=admin@mthunzi.tech

# Server-only (Edge Functions / local scripts — never commit real values)
# SUPABASE_SERVICE_ROLE_KEY=

# ParcelOS — copy to `.env` / `.env.local`

# Public (browser-safe — RLS enforced)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# App — must be your LIVE public site (Netlify / custom domain). Never localhost.
# Used for customer share links, QR codes, and WhatsApp.
VITE_APP_URL=https://your-site.netlify.app
VITE_PLATFORM_OWNER_EMAIL=mthunzilabs2470@gmail.com

# --- Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets) ---
# SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=https://your-domain.com
#
# GenesysPay (Zambia — primary billing)
# Dashboard: https://genesyspay.com  · Docs: https://genesyspay.com/docs/v2
# GENESYSPAY_PUBLIC_KEY=pk_live_...
# GENESYSPAY_PRIVATE_KEY=sk_live_...
# GENESYSPAY_WEBHOOK_SECRET=...          # HMAC for X-Webhook-Signature
# GENESYSPAY_CALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/genesyspay-webhook
#
# CRON_SECRET=random_long_string         # protect subscription-validation cron
#
# Optional welcome/congrats email on company signup (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=ParcelOS <hello@your-domain.com>
#
# Optional SMS (Africa's Talking / Twilio)
# AT_API_KEY=
# AT_USERNAME=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+26...
# TWILIO_WHATSAPP_FROM=whatsapp:+1415...

# App Store / Play Store (optional Capacitor wrap)
# npm i @capacitor/core @capacitor/cli @capacitor/ios @capacitor/android
# npm run build && npx cap add ios && npx cap add android && npm run cap:sync
